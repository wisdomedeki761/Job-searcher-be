# ============================================================
# AJ-Scraper backend configuration
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ============================================================

# --- Server -------------------------------------------------
# HTTP listen address (default :8080)
SERVER_ADDR=

# --- Database -----------------------------------------------
# PostgreSQL connection string
DATABASE_URL=
# --- Super admin (seeded to DB on first start ONLY) ---------
# If a super admin already exists in the database these are ignored
# and nothing is re-seeded. Required when the database has no super admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# --- Auth ---------------------------------------------------
# HMAC secret for signing JWTs (use a long random string)
# [node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(64).toString('base64url'))"]
JWT_SECRET=
# Token lifetime (default 24h = 1 day)
JWT_EXPIRY=24h

# --- AI (OpenRouter) ----------------------------------------
# Used to enrich job types into search profiles and classify ambiguous posts
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Classify ambiguous posts with AI during the pipeline (true/false)
AI_CLASSIFY=true

# --- Scraping sources ---------------------------------------
# Apify API token (optional - leave empty to disable Apify sources)
APIFY_TOKEN=
# Comma-separated list of Apify actors. Two accepted forms:
#   1. Bare actor ID  -> source name is derived from the last path segment
#      APIFY_ACTORS=hirebase/job-search              (source name: "job-search")
#   2. Explicit name  -> use when you want a custom source name or the
#                        derived names would collide
#      APIFY_ACTORS=remote_jobs=apify/remote-jobs-scraper,li=apify/linkedin-jobs-scraper
# Actor IDs may use "/" or "~" as separator (both accepted by the Apify API).
APIFY_ACTORS=

# Optional: per-source input OVERRIDE. You normally do NOT need this:
#   - inputs are self-healing: when Apify says "Field input.X must be string"
#     (or "must be array", or an element "must be object"), the source coerces
#     it and retries by itself
#   - known actors ship with built-in presets keyed by their actor ID:
#       hirebase/job-search            -> keywords/locations arrays, postedWithinDays
#       trudax/reddit-scraper-lite     -> native `searches` (no startUrls needed)
#       curious_coder/linkedin-jobs-scraper -> ONE search URL per keyword
# This exists only for actors whose schema needs a different SHAPE of input.
# Placeholders: {{query}} {{keywords}} {{keywords_str}} {{locations}}
# {{locations_str}} {{job_type}} {{since}} {{lookback_hours}} {{lookback_days}}
# Exact match -> native value (array for keywords/locations, number for
# {{lookback_days}}); *_str -> comma-separated string.
# NOTE: wrap the whole value in single quotes inside .env (the JSON uses double quotes).
#   APIFY_INPUTS={'some-actor':{"keywords":"{{keywords_str}}","pageCount":1}}
APIFY_INPUTS=
# Register a built-in mock source for local development (true/false)
MOCK_SOURCES=

# --- Scheduler ----------------------------------------------
# IANA timezone used to interpret cron expressions (e.g. UTC, Africa/Lagos, America/New_York)
TZ=UTC
# Maximum duration of a single scheduled run before it is cancelled
RUN_TIMEOUT=